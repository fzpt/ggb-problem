# OCR provider: mock | baidu
OCR_PROVIDER=mock

# Baidu OCR credentials (only needed if OCR_PROVIDER=baidu)
BAIDU_API_KEY=your_baidu_api_key
BAIDU_SECRET_KEY=your_baidu_secret_key
# Optional: general_basic | accurate_basic | webimage
BAIDU_OCR_ENDPOINT=general_basic

# LLM provider: mock | kimi | openai
LLM_PROVIDER=mock

# Kimi credentials (only needed if LLM_PROVIDER=kimi)
KIMI_API_KEY=your_kimi_api_key
# Optional: kimi-k2.6 | kimi-k2.6-2024-05-16 | kimi-k2.6-2024-05-16
KIMI_MODEL=kimi-k2.6

# OpenAI credentials (only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key
# Optional: gpt-4o | gpt-4o-mini
OPENAI_MODEL=gpt-4o

# Server port (optional)
PORT=3000